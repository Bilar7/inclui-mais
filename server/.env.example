# Copie este ficheiro para server/.env e preencha o que tiver.
PORT=5173

# Professor virtual com IA (Claude, da Anthropic). Sem chave, usa o modo offline.
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-haiku-5-5

# Voz do servidor (opcional) — Piper: https://github.com/rhasspy/piper
# Vozes: pt_PT-tugão-medium, pt_BR-faber-medium, en_US-lessac-medium, es_ES-davefx-medium
PIPER_BIN=
PIPER_VOICE_PT=
PIPER_VOICE_EN=
PIPER_VOICE_ES=

# Animação facial NVIDIA Audio2Face-3D (opcional) — serviço em server/a2f/
A2F_SIDECAR_URL=
